<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ImagePixelation.MainWindow"
        Title="Image Pixelation"
        Width="1000"
        Height="700"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,*" Margin="15" RowSpacing="10">

        <TextBlock x:Name="ImageInfo"
                   Grid.Row="0"
                   FontSize="14"/>
        
        <ProgressBar x:Name="ProcessingProgress"
             Grid.Row="1"
             Minimum="0"
             Maximum="100"
             Value="0"
             Height="12"/>

        <Border Grid.Row="2"
                Background="#222222"
                ClipToBounds="True">

            <Image x:Name="ImageDisplay"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"/>

        </Border>

    </Grid>
</Window>
